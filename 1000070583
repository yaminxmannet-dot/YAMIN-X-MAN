const express = require('express');
const session = require('express-session');
const helmet = require('helmet');
const multer = require('multer');
const path = require('path');
const fs = require('fs');
const crypto = require('crypto');

const app = express();
const PORT = process.env.PORT || 3000;
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || '1214';
const SESSION_SECRET = process.env.SESSION_SECRET || 'CHANGE_THIS_SESSION_SECRET_BEFORE_PUBLIC_DEPLOYMENT';
const UPLOAD_DIR = path.join(__dirname, 'uploads');
const DATA_FILE = path.join(__dirname, 'files.json');
fs.mkdirSync(UPLOAD_DIR, { recursive: true });
if (!fs.existsSync(DATA_FILE)) fs.writeFileSync(DATA_FILE, '[]');

app.use(helmet({ contentSecurityPolicy: false }));
app.use(express.json());
app.use(express.static(path.join(__dirname, 'public')));
app.use(session({
  name: 'yxm.sid',
  secret: SESSION_SECRET,
  resave: false,
  saveUninitialized: false,
  cookie: { httpOnly: true, sameSite: 'lax', secure: process.env.NODE_ENV === 'production', maxAge: 8 * 60 * 60 * 1000 }
}));

const admins = ['admin1', 'admin2', 'admin3'];
const storage = multer.diskStorage({
  destination: (_, __, cb) => cb(null, UPLOAD_DIR),
  filename: (_, file, cb) => {
    const safeExt = path.extname(file.originalname).replace(/[^.a-zA-Z0-9]/g, '').slice(0, 15);
    cb(null, crypto.randomBytes(18).toString('hex') + safeExt);
  }
});
const upload = multer({
  storage,
  limits: { fileSize: 250 * 1024 * 1024, files: 1 }
});

function readFiles() { return JSON.parse(fs.readFileSync(DATA_FILE, 'utf8')); }
function writeFiles(items) { fs.writeFileSync(DATA_FILE, JSON.stringify(items, null, 2)); }
function requireAdmin(req, res, next) {
  if (req.session && admins.includes(req.session.admin)) return next();
  return res.status(401).json({ error: 'ابتدا وارد حساب مدیر شوید.' });
}

app.post('/api/login', (req, res) => {
  const { username, password } = req.body || {};
  if (!admins.includes(username) || password !== ADMIN_PASSWORD) {
    return res.status(401).json({ error: 'نام کاربری یا رمز اشتباه است.' });
  }
  req.session.admin = username;
  res.json({ ok: true, username });
});
app.post('/api/logout', (req, res) => {
  req.session.destroy(() => res.json({ ok: true }));
});
app.get('/api/me', (req, res) => {
  res.json({ loggedIn: !!(req.session && admins.includes(req.session.admin)), username: req.session?.admin || null });
});
app.get('/api/files', (_, res) => {
  const items = readFiles().map(({ id, originalName, size, uploadedAt, uploadedBy }) => ({ id, originalName, size, uploadedAt, uploadedBy }));
  res.json(items.reverse());
});
app.post('/api/upload', requireAdmin, upload.single('file'), (req, res) => {
  if (!req.file) return res.status(400).json({ error: 'فایلی انتخاب نشده است.' });
  const items = readFiles();
  const item = {
    id: req.file.filename,
    storedName: req.file.filename,
    originalName: path.basename(req.file.originalname).slice(0, 240),
    size: req.file.size,
    uploadedAt: new Date().toISOString(),
    uploadedBy: req.session.admin
  };
  items.push(item); writeFiles(items);
  res.json({ ok: true, file: item });
});
app.get('/api/download/:id', (req, res) => {
  const item = readFiles().find(f => f.id === req.params.id);
  if (!item) return res.status(404).send('فایل پیدا نشد.');
  res.download(path.join(UPLOAD_DIR, item.storedName), item.originalName);
});
app.delete('/api/files/:id', requireAdmin, (req, res) => {
  const items = readFiles();
  const item = items.find(f => f.id === req.params.id);
  if (!item) return res.status(404).json({ error: 'فایل پیدا نشد.' });
  const target = path.join(UPLOAD_DIR, item.storedName);
  if (fs.existsSync(target)) fs.unlinkSync(target);
  writeFiles(items.filter(f => f.id !== req.params.id));
  res.json({ ok: true });
});
app.use((err, req, res, next) => {
  if (err instanceof multer.MulterError) return res.status(400).json({ error: err.code === 'LIMIT_FILE_SIZE' ? 'حداکثر حجم هر فایل ۲۵۰ مگابایت است.' : 'بارگذاری فایل انجام نشد.' });
  console.error(err);
  res.status(500).json({ error: 'خطای داخلی سرور.' });
});
app.listen(PORT, () => console.log(`Yamin X Man running on port ${PORT}`));
